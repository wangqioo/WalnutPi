# WalnutPi local Web AI configuration.
# Copy to .env for local use. .env is ignored by Git.

# OpenAI-compatible /responses endpoint.
WALNUT_AI_BASE_URL=https://rehdasu.cn/v1

# Model used by Web intent classification, screen generation, and AI summaries.
WALNUT_AI_MODEL=gpt-5.4-mini

# Prefer a WalnutPi-scoped key. OPENAI_API_KEY is still accepted when exported explicitly.
WALNUT_AI_API_KEY=
