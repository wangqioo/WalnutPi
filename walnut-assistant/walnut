def status(_: argparse.Namespace | None = None) -> int:
    section("WalnutPi")
    print(one_line(["hostnamectl"], "hostnamectl unavailable"))

    section("Network")
    print(one_line(["ip", "-br", "addr"]))
    print(one_line(["ip", "route", "show", "default"]))
    if exists("nmcli"):
        print(one_line(["nmcli", "-t", "-f", "ACTIVE,SSID,SIGNAL", "dev", "wifi"]))

    section("Storage")
    print(one_line(["df", "-h", "/", "/boot"]))
    print(one_line(["findmnt", "-n", "-o", "SOURCE,FSTYPE,OPTIONS,TARGET", "/"]))

    section("Memory")
    print(one_line(["free", "-h"]))

    section("Services")
    for service in ["ssh", "NetworkManager", "docker", "frpc", "voice-keyboard-walnutpi", "bluealsa-aplay", "bluetooth"]:
        state = one_line(root_cmd(["systemctl", "is-active", service]), "unknown")
        enabled = one_line(root_cmd(["systemctl", "is-enabled", service]), "unknown")
        print(f"{service:26} active={state:10} enabled={enabled}")

    section("Docker")
    if exists("docker"):
        if is_root():
            print(one_line(["docker", "ps", "--format", "table {{.Names}}\t{{.Image}}\t{{.Status}}\t{{.Ports}}"]))
        else:
            print("Docker is installed. Run `sudo walnut status` to inspect containers.")
    else:
        print("docker not installed")

    section("Audio")
    print(one_line(["bluetoothctl", "info", AIRPODS_MAC], "AirPods not known"))
    return 0


def clipped_action_output(value: str) -> str:
    if len(value) <= ACTION_OUTPUT_LIMIT:
        return value
    return value[:ACTION_OUTPUT_LIMIT] + "\n\n[walnut action] output truncated"


def captured_function_output(func, args: argparse.Namespace | None = None) -> tuple[int | None, str]:
    buffer = io.StringIO()
    try:
        with contextlib.redirect_stdout(buffer), contextlib.redirect_stderr(buffer):
            code = func(args)
    except Exception as error:
        return None, f"[walnut action] {error}"
    output = buffer.getvalue().strip() or "ok"
    return code, clipped_action_output(output)


def action_network(_: argparse.Namespace | None = None) -> int:
    section("Network")
    print("hostname -I:")
    print(one_line(["hostname", "-I"], "unavailable"))
    print("ip -br addr:")
    print(one_line(["ip", "-br", "addr"], "unavailable"))
    print("default route:")
    print(one_line(["ip", "route", "show", "default"], "unavailable"))
    if exists("nmcli"):
        print("wifi:")
        print(one_line(["nmcli", "-t", "-f", "ACTIVE,SSID,SIGNAL", "dev", "wifi"]))
    return 0


def action_gpio(_: argparse.Namespace | None = None) -> int:
    section("GPIO")
    if exists("gpio"):
        for cmd in [
            ["gpio", "pins"],
            ["gpio", "pin", "i2c"],
            ["gpio", "pin", "spi"],
            ["gpio", "pin", "uart"],
            ["gpio", "pin", "pwm"],
        ]:
            print(f"$ {' '.join(cmd)}")
            print(one_line(cmd))
    else:
        print("gpio unavailable")

    section("set-device")
    print(one_line(["set-device", "status"], "set-device unavailable"))

    config = Path("/boot/config.txt")
    section("/boot/config.txt")
    if config.exists():
        try:
            print("\n".join(config.read_text(encoding="utf-8", errors="replace").splitlines()[:160]))
        except OSError as error:
            print(f"read failed: {error}")
    else:
        print("missing")
    return 0


def action_i2c_scan(_: argparse.Namespace | None = None) -> int:
    section("I2C device nodes")
    buses = sorted(Path("/dev").glob("i2c-*"))
    if buses:
        for bus in buses:
            print(str(bus))
    else:
        print("no /dev/i2c-* nodes found")

    section("i2cdetect")
    if not exists("i2cdetect"):
        print("i2cdetect unavailable; address scan was not run")
        return 1
    if not buses:
        print("no I2C buses to scan")
        return 1

    scanned_any = False
    for bus in buses:
        number = bus.name.removeprefix("i2c-")
        if not number.isdigit():
            continue
        cmd = ["i2cdetect", "-y", "-r", number]
        print(f"$ {' '.join(cmd)}")
        try:
            result = subprocess.run(cmd, text=True, stdout=subprocess.PIPE, stderr=subprocess.STDOUT, timeout=4)
        except subprocess.TimeoutExpired:
            print("timed out after 4s; continuing with remaining buses")
            continue
        print(result.stdout.strip() or "empty")
        scanned_any = scanned_any or result.returncode == 0
    return 0 if scanned_any else 1


def action_snapshot(_: argparse.Namespace | None = None) -> int:
    section("Device")
    print(one_line(["hostname"]))
    print(one_line(["uname", "-a"]))

    for label, path in [
        ("/etc/WalnutPi-release", Path("/etc/WalnutPi-release")),
        ("/etc/os-release", Path("/etc/os-release")),
        ("framebuffer size", Path("/sys/class/graphics/fb0/virtual_size")),
        ("framebuffer name", Path("/sys/class/graphics/fb0/name")),
        ("/boot/config.txt", Path("/boot/config.txt")),
    ]:
        section(label)
        if path.exists():
            try:
                data = path.read_text(encoding="utf-8", errors="replace").strip()
            except OSError as error:
                data = f"read failed: {error}"
            if label == "/boot/config.txt":
                data = "\n".join(data.splitlines()[:160])
            print(data or "empty")
        else:
            print("missing")

    action_gpio(None)
    return 0


