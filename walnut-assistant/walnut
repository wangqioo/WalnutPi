def read_actions() -> dict[str, dict[str, object]]:
    actions: dict[str, dict[str, object]] = {}
    for action_id, spec in policy_actions_for_executor("walnut-cli").items():
        if spec.get("risk") != "read" or action_id not in READ_ACTION_HANDLERS:
            continue
        actions[action_id] = {
            "title": spec["title"],
            "risk": spec["risk"],
            "mode": "read",
            "handler": READ_ACTION_HANDLERS[action_id]["handler"],
        }
    return actions


def prepare_actions() -> dict[str, dict[str, object]]:
    actions: dict[str, dict[str, object]] = {}
    for action_id, spec in policy_actions_for_executor("walnut-cli").items():
        if spec.get("mode") != "confirmable" or not spec.get("confirmationRequired"):
            continue
        cli = spec.get("walnutCli") if isinstance(spec.get("walnutCli"), dict) else {}
        command = cli.get("command")
        explanation = cli.get("explanation")
        if not command or not explanation:
            continue
        actions[action_id] = {
            "title": spec["title"],
            "risk": spec["risk"],
            "mode": spec["mode"],
            "command": command,
            "explanation": explanation,
        }
    return actions


def action_result(action_id: str, spec: dict[str, object], code: int | None, output: str) -> dict[str, object]:
    return {
        "schema": "walnut.local-action-result.v1",
        "ok": code == 0,
        "id": action_id,
        "title": spec["title"],
        "risk": spec["risk"],
        "mode": spec["mode"],
        "code": code,
        "output": output,
    }


def print_action_result(result: dict[str, object], as_json: bool) -> None:
    if as_json:
        print(json.dumps(result, ensure_ascii=False, indent=2))
        return

    print(f"== {result['title']} ==")
    print(f"risk: {result['risk']}")
    print()
    print(result.get("output") or "")


def action_run(args: argparse.Namespace) -> int:
    action_id = args.action
    actions = read_actions()
    spec = actions.get(action_id)
    if spec is None:
        print(f"Unknown read action: {action_id}", file=sys.stderr)
        print("Available: " + ", ".join(sorted(actions)), file=sys.stderr)
        return 2

    code, output = captured_function_output(spec["handler"])
    result = action_result(action_id, spec, code, output)
    print_action_result(result, args.json)
    return 0 if result["ok"] else 1


def pending_action(action_id: str, spec: dict[str, object]) -> dict[str, object]:
    now = int(time.time())
    return {
        "schema": "walnut.pending-local-action.v1",
        "id": action_id,
        "title": spec["title"],
        "risk": spec["risk"],
        "mode": spec["mode"],
        "command": spec["command"],
        "explanation": spec["explanation"],
        "token": secrets.token_urlsafe(18),
        "created_at": now,
        "expires_at": now + PENDING_ACTION_TTL_SECONDS,
        "state": "pending",
    }


def print_pending_action(pending: dict[str, object], as_json: bool) -> None:
    if as_json:
        print(json.dumps(pending, ensure_ascii=False, indent=2))
        return

    print(f"== {pending['title']} ==")
    print(f"risk: {pending['risk']}")
    print(f"command: {pending['command']}")
    print()
    print(pending["explanation"])
    print()
    print("This action is prepared only. Confirm it from the active WalnutAI or Web Agent Console session.")


def action_prepare(args: argparse.Namespace) -> int:
    action_id = args.action
    actions = prepare_actions()
    spec = actions.get(action_id)
    if spec is None:
        print(f"Unknown confirmable action: {action_id}", file=sys.stderr)
        print("Available: " + ", ".join(sorted(actions)), file=sys.stderr)
        return 2

    print_pending_action(pending_action(action_id, spec), args.json)
    return 0


def read_pending_action() -> dict[str, object] | None:
    try:
        data = json.loads(sys.stdin.read())
    except json.JSONDecodeError as error:
        print(f"Invalid pending action JSON: {error}", file=sys.stderr)
        return None
    if not isinstance(data, dict):
        print("Invalid pending action JSON: expected object", file=sys.stderr)
        return None
    return data


def validate_pending_action(data: dict[str, object]) -> str | None:
    if data.get("schema") != "walnut.pending-local-action.v1":
        return "pending action schema is not supported"
    action_id = str(data.get("id", ""))
    spec = prepare_actions().get(action_id)
    if spec is None:
        return "pending action id is not allowed"
    for key in ("title", "risk", "mode", "command", "explanation"):
        if data.get(key) != spec[key]:
            return f"pending action {key} no longer matches the allowed action"
    token = str(data.get("token", ""))
    if not token:
        return "pending action token is missing"
    try:
        expires_at = int(data.get("expires_at", 0))
    except (TypeError, ValueError):
        return "pending action expiry is invalid"
    if expires_at < int(time.time()):
        return "pending action has expired"
    return None


def action_commit(args: argparse.Namespace) -> int:
    data = read_pending_action()
    if data is None:
        return 2

    error = validate_pending_action(data)
    if error:
        result = {
            "ok": False,
            "id": data.get("id"),
            "title": data.get("title", "Pending Local Action"),
            "risk": data.get("risk", "high"),
            "mode": "confirmable",
            "code": None,
            "command": data.get("command"),
            "output": error,
        }
        print_action_result(result, args.json)
        return 2

    result = {
        "ok": False,
        "id": data["id"],
        "title": data["title"],
        "risk": data["risk"],
        "mode": "confirmable",
        "code": None,
        "command": data["command"],
        "output": "Confirmed execution is not enabled in this WalnutPi Local Action slice.",
    }
    print_action_result(result, args.json)
    return 1


def action_cli(args: argparse.Namespace) -> int:
    if args.action_cmd == "run":
        return action_run(args)
    if args.action_cmd == "prepare":
        return action_prepare(args)
    if args.action_cmd == "commit":
        return action_commit(args)
    print("Missing action command. Use run, prepare, or commit.", file=sys.stderr)
    return 2


def screen_service_state(service: str) -> str:
    return run(root_cmd(["systemctl", "is-active", service])).stdout.strip() or "unknown"


def start_walnut_screen() -> int:
    return subprocess.call(root_cmd(["systemctl", "start", "walnut-screen.service"]))


def start_lightfield_demo() -> int:
    current_root = project_root()
    binary = current_root / "build" / "lvgl_app" / "walnut-lvgl-screen"
    if not binary.exists():
        print(f"LVGL binary is missing: {binary}")
        print(f"Run: cd {current_root} && scripts/build-lvgl-app.sh")
        return 1
    subprocess.call(root_cmd(["systemctl", "stop", "walnut-screen.service"]))
    subprocess.call(root_cmd(["systemctl", "stop", "walnut-framebuffer-status.service"]))
    subprocess.call(root_cmd(["pkill", "-f", "walnut-lightfield-camera-loop"]))
    subprocess.call(root_cmd(["pkill", "-f", str(binary)]))
    if not shutil.which("ffmpeg"):
        subprocess.call(root_cmd(["apt-get", "update"]))
        subprocess.call(root_cmd(["env", "DEBIAN_FRONTEND=noninteractive", "apt-get", "install", "-y", "ffmpeg"]))
    subprocess.call(["/bin/sh", "-c", "echo 0 > /sys/class/vtconsole/vtcon1/bind"])
    subprocess.call(root_cmd(["/bin/sh", "-c", "TERM=linux setterm --cursor off > /dev/tty1"]))
    # ponytail: one tiny PGM is the camera/game boundary; replace ffmpeg later if needed.
    subprocess.Popen(
        [
            "sh",
            "-c",
            "while :; do ffmpeg -hide_banner -loglevel error -f v4l2 -input_format mjpeg -video_size 480x320 -i /dev/video1 -frames:v 1 -vf scale=16:12,hflip,format=gray -y /tmp/walnut-lightfield.tmp.pgm && mv /tmp/walnut-lightfield.tmp.pgm /tmp/walnut-lightfield.pgm; sleep 0.2; done",
            "walnut-lightfield-camera-loop",
        ],
        stdout=open("/tmp/walnut-lightfield-camera.log", "ab"),
        stderr=subprocess.STDOUT,
        start_new_session=True,
    )
    subprocess.Popen(
        [str(binary), "--demo", "lightfield", "/dev/fb0"],
        cwd=str(current_root),
        stdout=open("/tmp/walnut-lightfield.log", "ab"),
        stderr=subprocess.STDOUT,
        start_new_session=True,
    )
    return 0


def restore_screen_login() -> int:
    subprocess.call(root_cmd(["systemctl", "stop", "walnut-screen.service"]))
    subprocess.call(root_cmd(["pkill", "-f", "walnut-lightfield-camera-loop"]))
    code = subprocess.call(root_cmd(["systemctl", "stop", "walnut-framebuffer-status.service"]))
    subprocess.call(["/bin/sh", "-c", "echo 1 > /sys/class/vtconsole/vtcon1/bind"])
    subprocess.call(root_cmd(["systemctl", "start", "getty@tty1.service"]))
    return code


def print_screen_state() -> int:
    section("Screen")
    print(f"walnut-screen.service              {screen_service_state('walnut-screen.service')}")
    print(f"walnut-framebuffer-status.service  {screen_service_state('walnut-framebuffer-status.service')}")
    vtcon = Path("/sys/class/vtconsole/vtcon1/bind")
    if vtcon.exists():
        print(f"vtcon1 bind                        {vtcon.read_text(encoding='utf-8').strip()}")
    return 0


def print_screen_frame() -> int:
    current_root = project_root()
    if str(current_root) not in sys.path:
        sys.path.insert(0, str(current_root))
    try:
        from framebuffer_ui import fb

        print(json.dumps(fb.read_frame_evidence(), ensure_ascii=True, sort_keys=True))
        return 0
    except OSError as error:
        print(f"screen frame evidence failed: {error}")
        return 1


def print_screen_capture(args: argparse.Namespace) -> int:
    current_root = project_root()
    if str(current_root) not in sys.path:
        sys.path.insert(0, str(current_root))
    try:
        from framebuffer_ui import capture

        payload, _ = capture.capture_png(include_base64=getattr(args, "png_base64", False))
        print(json.dumps(payload, ensure_ascii=True, sort_keys=True))
        return 0
    except (OSError, ValueError) as error:
        print(f"screen capture failed: {error}")
        return 1


def screen(args: argparse.Namespace) -> int:
    command = getattr(args, "screen_cmd", "menu")
    if command == "menu":
        return screen_menu(args)
    if command in {"start", "lvgl-demo"}:
        if not require_root(f"screen {command}"):
            return 1
        if command == "lvgl-demo" and getattr(args, "demo_name", None) == "lightfield":
            return start_lightfield_demo()
        return start_walnut_screen()
    if command in {"stop", "restore"}:
        if not require_root(f"screen {command}"):
            return 1
        return restore_screen_login()
    if command == "toggle":
        if not require_root("screen toggle"):
            return 1
        if screen_service_state("walnut-screen.service") == "active":
            return restore_screen_login()
        return start_walnut_screen()
    if command == "state":
        return print_screen_state()
    if command == "frame":
        return print_screen_frame()
    if command == "capture":
        return print_screen_capture(args)
    if command == "status":
        if not require_root("screen status"):
            return 1
        return subprocess.call(root_cmd(["systemctl", "start", "walnut-framebuffer-status.service"]))
    if command in {"test", "demo", "off"}:
        current_root = project_root()
        env = os.environ.copy()
        env["PYTHONPATH"] = str(current_root)
        subprocess.call(root_cmd(["systemctl", "stop", "walnut-framebuffer-status.service"]))
        demo = {"test": "test", "demo": "card", "off": "off"}[command]
        return subprocess.call(
            ["python3", "-m", "framebuffer_ui.draw_demo", demo],
            cwd=str(current_root),
            env=env,
        )
    if command == "image":
        current_root = project_root()
        env = os.environ.copy()
        env["PYTHONPATH"] = str(current_root)
        subprocess.call(root_cmd(["systemctl", "stop", "walnut-framebuffer-status.service"]))
        return subprocess.call(
            ["python3", "-m", "framebuffer_ui.draw_image", args.path],
            cwd=str(current_root),
            env=env,
        )
    if command == "ai":
        current_root = project_root()
        env = os.environ.copy()
        env["PYTHONPATH"] = str(current_root)
        text = getattr(args, "text", []) or []
        if text:
            ai_text = " ".join(text).strip()
            try:
                Path("/run/walnut-screen-ai.txt").write_text(ai_text + "\n", encoding="utf-8")
            except OSError:
                pass
            if run(root_cmd(["systemctl", "is-active", "walnut-screen.service"])).stdout.strip() == "active":
                print("updated LVGL AI page")
                return 0
        subprocess.call(root_cmd(["systemctl", "stop", "walnut-framebuffer-status.service"]))
        return subprocess.call(
            ["python3", "-m", "framebuffer_ui.draw_ai", *text],
            cwd=str(current_root),
            env=env,
        )
    if command == "app":
        current_root = project_root()
        env = os.environ.copy()
        env["PYTHONPATH"] = str(current_root)
        subprocess.call(root_cmd(["systemctl", "stop", "walnut-framebuffer-status.service"]))
        return subprocess.call(
            ["python3", "-m", "framebuffer_ui.screen_app"],
            cwd=str(current_root),
            env=env,
        )
    if command == "lvgl":
        current_root = project_root()
        binary = current_root / "build" / "lvgl_app" / "walnut-lvgl-screen"
        if not binary.exists():
            print(f"LVGL binary is missing: {binary}")
            print(f"Run: cd {current_root} && scripts/build-lvgl-app.sh")
            return 1
        subprocess.call(root_cmd(["systemctl", "stop", "walnut-framebuffer-status.service"]))
        return subprocess.call([str(binary), "/dev/fb0"], cwd=str(current_root))
    print("Usage: walnut screen [start|stop|toggle|state|frame|capture|status|test|demo|off|image|ai|app|lvgl|lvgl-demo|restore]")
    return 2


def clean(_: argparse.Namespace | None = None) -> int:
    if not require_root("clean"):
        return 1
    print("Walnut clean keeps projects, music, Codex config, GitHub login, Docker data, and Uptime Kuma data.")
    print("Cleaning apt cache, old journals, and old temp files...")
    commands = [
        root_cmd(["apt-get", "clean"]),
        root_cmd(["journalctl", "--vacuum-size=50M"]),
        ["find", "/tmp", "-mindepth", "1", "-maxdepth", "1", "-mtime", "+1", "-delete"],
        ["find", "/var/tmp", "-mindepth", "1", "-maxdepth", "1", "-mtime", "+7", "-delete"],
    ]
    for cmd in commands:
        print(f"$ {' '.join(cmd)}")
        subprocess.call(cmd)
    section("After Clean")
    print(one_line(["df", "-h", "/"]))
    return 0


def fix_audio(_: argparse.Namespace | None = None) -> int:
    if not require_root("fix-audio"):
        return 1
    print("Switching Bluetooth audio back to PulseAudio A2DP playback mode.")
    subprocess.call(root_cmd(["systemctl", "disable", "--now", "bluealsa-aplay"]))
    subprocess.call(root_cmd(["systemctl", "disable", "--now", "bluealsa"]))
    subprocess.call(root_cmd(["pkill", "-f", "^/usr/bin/bluealsa-aplay"]))
    if exists("vk-airpods-audio"):
        return stream(["vk-airpods-audio"])
    print("vk-airpods-audio is missing")
    return 1


def projects(_: argparse.Namespace | None = None) -> int:
    section("Projects")
    for path in [project_root(), project_root() / "archive" / "experiments" / "voice-keyboard", Path("/opt/walnut-ai"), Path("/opt/uptime-kuma"), Path("/opt/frp")]:
        if path.exists():
            print(path)
    section("Git")
    current_root = project_root()
    if current_root.exists():
        subprocess.call(["git", "config", "--global", "--add", "safe.directory", str(current_root)])
        subprocess.call(["git", "-C", str(current_root), "status", "--short"])
    return 0


def note(args: argparse.Namespace) -> int:
    NOTES_DIR.mkdir(parents=True, exist_ok=True)
    text = " ".join(args.text).strip()
    if not text:
        print("Usage: walnut note your text")
        return 2
    path = NOTES_DIR / f"{datetime.now().date().isoformat()}.md"
    with path.open("a", encoding="utf-8") as f:
        f.write(f"\n- {datetime.now().strftime('%H:%M')} {text}\n")
    print(f"saved: {path}")
    return 0


def today(_: argparse.Namespace | None = None) -> int:
    path = NOTES_DIR / f"{datetime.now().date().isoformat()}.md"
    if path.exists():
        print(path.read_text(encoding="utf-8"))
    else:
        print("No notes today.")
    return 0


def open_ai(args: argparse.Namespace | None = None) -> int:
    if exists("walnut-ai"):
        text = getattr(args, "text", []) if args is not None else []
        return stream(["walnut-ai", *text] if text else ["walnut-ai"])
    print("walnut-ai is missing")
    return 1


def voice(_: argparse.Namespace | None = None) -> int:
    if exists("walnut-voice-cli"):
        return stream(["walnut-voice-cli"])
    print("walnut-voice-cli is missing")
    return 1


def menu(_: argparse.Namespace | None = None) -> int:
    while True:
        clear_screen()
        print("Walnut Home")
        print()
        print("  1. Notes")
        print("  2. Status")
        print("  3. Screen")
        if os.getenv("WALNUT_SESSION_MODE") == "local":
            print("  9. Return to login")
        print()
        print("  q. Exit")
        print()
        print("Advanced tools remain available as direct commands:")
        print("  walnut ai | play | console | maintenance | video | voice")
        choice = input("\nSelect> ").strip().lower()
        if choice == "1":
            notes_menu(None)
        elif choice == "2":
            status(None)
            input("\nPress Enter...")
        elif choice == "3":
            screen_menu(None)
        elif choice == "9" and os.getenv("WALNUT_SESSION_MODE") == "local":
            return 2
        elif choice in {"q", "quit", "exit"}:
            return 0


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(description="Walnut Home")
    sub = parser.add_subparsers(dest="cmd")

    commands = {
        "status": status,
        "ai": open_ai,
        "notes": notes_menu,
        "play": play_menu,
        "console": console_menu,
        "maintenance": maintenance_menu,
        "video": open_video,
        "voice": voice,
        "today": today,
    }
    for name, func in commands.items():
        p = sub.add_parser(name)
        if name == "ai":
            p.add_argument("text", nargs=argparse.REMAINDER)
        if name == "video":
            p.add_argument("mode", nargs="?", choices=["color", "gray", "still-color", "still-gray"], default="color")
        p.set_defaults(func=func)

    p_action = sub.add_parser("action")
    p_action.set_defaults(func=action_cli)
    action_sub = p_action.add_subparsers(dest="action_cmd")
    try:
        read_action_choices = sorted(read_actions())
        prepare_action_choices = sorted(prepare_actions())
    except RuntimeError:
        read_action_choices = sorted(READ_ACTION_HANDLERS)
        prepare_action_choices = ["reboot"]

    p_action_run = action_sub.add_parser("run")
    p_action_run.add_argument("action", choices=read_action_choices)
    p_action_run.add_argument("--json", action="store_true")
    p_action_run.set_defaults(func=action_cli)

    p_action_prepare = action_sub.add_parser("prepare")
    p_action_prepare.add_argument("action", choices=prepare_action_choices)
    p_action_prepare.add_argument("--json", action="store_true")
    p_action_prepare.set_defaults(func=action_cli)

    p_action_commit = action_sub.add_parser("commit")
    p_action_commit.add_argument("--json", action="store_true")
    p_action_commit.set_defaults(func=action_cli)

    p_screen = sub.add_parser("screen")
    screen_sub = p_screen.add_subparsers(dest="screen_cmd")
    for name in ["start", "stop", "toggle", "state", "frame", "status", "test", "demo", "off", "restore", "app", "lvgl"]:
        screen_sub.add_parser(name)
    p_lvgl_demo = screen_sub.add_parser("lvgl-demo")
    p_lvgl_demo.add_argument("demo_name", nargs="?")
    p_capture = screen_sub.add_parser("capture")
    p_capture.add_argument("--png-base64", action="store_true")
    p_image = screen_sub.add_parser("image")
    p_image.add_argument("path")
    p_ai = screen_sub.add_parser("ai")
    p_ai.add_argument("text", nargs="*")
    p_screen.set_defaults(func=screen, screen_cmd="menu")

    p_note = sub.add_parser("note")
    p_note.add_argument("text", nargs="*")
    p_note.set_defaults(func=note)

    return parser


def main() -> int:
    parser = build_parser()
    args = parser.parse_args()
    if not args.cmd:
        return menu(args)
    return args.func(args)


if __name__ == "__main__":
    raise SystemExit(main())
