def run(cmd: list[str], check: bool = False) -> subprocess.CompletedProcess[str]:
    return subprocess.run(cmd, text=True, stdout=subprocess.PIPE, stderr=subprocess.STDOUT, check=check)


def stream(cmd: list[str]) -> int:
    try:
        return subprocess.call(cmd)
    except FileNotFoundError:
        print(f"missing command: {cmd[0]}")
        return 127


def exists(cmd: str) -> bool:
    return shutil.which(cmd) is not None


def is_root() -> bool:
    geteuid = getattr(os, "geteuid", None)
    return callable(geteuid) and geteuid() == 0


def first_existing_path(candidates: list[Path | None], fallback: Path) -> Path:
    for path in candidates:
        if path is not None and path.exists():
            return path
    return fallback


def root_cmd(cmd: list[str]) -> list[str]:
    if is_root():
        return cmd
    if os.name != "nt" and exists("sudo"):
        return ["sudo", "-n", *cmd]
    return cmd


def require_root(action: str) -> bool:
    if is_root():
        return True
    print(f"{action} needs administrator permission.")
    print(f"Run: sudo walnut {action}")
    return False


def section(title: str) -> None:
    print(f"\n== {title} ==")


def pause(prompt: str = "Press Enter...") -> None:
    input(f"\n{prompt}")


def clear_screen() -> None:
    os.system("clear")


def one_line(cmd: list[str], fallback: str = "-") -> str:
    try:
        result = run(cmd)
        if result.returncode != 0:
            return fallback
        out = result.stdout.strip()
        return out if out else fallback
    except Exception:
        return fallback


def music_dir() -> Path:
    return first_existing_path(MUSIC_DIR_CANDIDATES, HOME / "music-library")


def project_root() -> Path:
    return first_existing_path(PROJECT_ROOT_CANDIDATES, HOME / "projects" / "WalnutPi")


def action_policy_manifest_path() -> Path:
    return first_existing_path(ACTION_POLICY_MANIFEST_CANDIDATES, project_root() / "action-policy-manifest.json")


def load_action_policy_manifest() -> dict[str, object]:
    path = action_policy_manifest_path()
    try:
        data = json.loads(path.read_text(encoding="utf-8"))
    except OSError as error:
        raise RuntimeError(f"Action Policy Manifest is missing: {path}") from error
    except json.JSONDecodeError as error:
        raise RuntimeError(f"Action Policy Manifest is invalid JSON: {path}: {error}") from error
    if data.get("schema") != "walnutpi.action-policy-manifest.v1":
        raise RuntimeError("Action Policy Manifest schema is not supported")
    actions = data.get("actions")
    if not isinstance(actions, dict):
        raise RuntimeError("Action Policy Manifest actions must be an object")
    return data


def policy_actions_for_executor(executor: str) -> dict[str, dict[str, object]]:
    manifest = load_action_policy_manifest()
    out: dict[str, dict[str, object]] = {}
    for action_id, spec in manifest["actions"].items():
        if not isinstance(spec, dict):
            continue
        allowed = spec.get("allowedExecutors")
        if isinstance(allowed, list) and executor in allowed:
            out[str(action_id)] = spec
    return out


def prepare_music() -> tuple[Path, Path, Path]:
    current_music_dir = music_dir()
    MUSIC_LINK.parent.mkdir(parents=True, exist_ok=True)
    CMUS_PLAYLIST.parent.mkdir(parents=True, exist_ok=True)

    if current_music_dir.exists():
        try:
            if MUSIC_LINK.is_symlink() or MUSIC_LINK.is_file():
                MUSIC_LINK.unlink()
            if not MUSIC_LINK.exists():
                MUSIC_LINK.symlink_to(current_music_dir, target_is_directory=True)
        except OSError:
            pass

        tracks = sorted(
            str(path)
            for path in current_music_dir.rglob("*")
            if path.is_file() and path.suffix.lower() in MUSIC_EXTENSIONS
        )
        CMUS_PLAYLIST.write_text(
            "\n".join(tracks) + ("\n" if tracks else ""),
            encoding="utf-8",
        )

    return current_music_dir, MUSIC_LINK, CMUS_PLAYLIST


