{
  "schema": "walnutpi.screen.v1",
  "id": "walnutpi-lvgl-status",
  "title": "Night Desk",
  "subtitle": "lofi focus player",
  "target": {
    "runtime": "lvgl-fbdev",
    "display": "/dev/fb0",
    "width": 480,
    "height": 320,
    "color": "RGB565"
  },
  "source": {
    "lvglEntry": "lvgl_app/src/main.c",
    "command": "walnut screen start"
  },
  "pages": [
    {
      "id": "main",
      "tab": "MAIN",
