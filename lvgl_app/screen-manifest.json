          "style": "music",
          "kicker": "Now Playing",
          "headline": "MIDNIGHT LOFI",
          "body": "Soft beats for a quiet desk. Stay in flow.",
          "badge": "PLAY",
          "accent": "blue",
          "progress": 42,
          "items": [
            {
              "label": "Track",
              "value": "Night Desk",
              "unit": "",
              "tone": "ok"
            },
            {
              "label": "Vol",
              "value": "36",
              "unit": "%",
              "tone": "ok"
            },
            {
              "label": "Out",
              "value": "Desk Spk",
              "unit": "",
              "tone": "ok"
            }
          ]
        }
      ]
    }
  ]
}
