[Unit]
Description=WalnutPi framebuffer status screen
After=local-fs.target

[Service]
Type=simple
WorkingDirectory=/home/pi/projects/WalnutPi
Environment=PYTHONPATH=/home/pi/projects/WalnutPi/archive/experiments
ExecStartPre=-/usr/bin/pkill fbterm
ExecStartPre=-/bin/sh -c 'TERM=linux /usr/bin/setterm --cursor off > /dev/tty1'
ExecStart=/usr/bin/python3 -m framebuffer_ui.draw_status --watch 5
ExecStopPost=-/bin/sh -c 'TERM=linux /usr/bin/setterm --cursor on > /dev/tty1'
ExecStopPost=-/bin/systemctl start getty@tty1.service
Restart=on-failure
RestartSec=2

[Install]
WantedBy=multi-user.target
