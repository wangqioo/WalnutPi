{
  "version": "v0.9.1",
  "createSurface": {
    "surfaceId": "device-status",
    "catalogId": "walnutpi.lvgl-widget-catalog.v1"
  },
  "updateComponents": {
    "surfaceId": "device-status",
    "components": [
      { "id": "root", "component": "Container" },
      { "id": "title", "component": "Text", "text": "DEVICE STATUS" },
      { "id": "ip", "component": "Text", "label": "IP", "value": { "path": "/ip" } },
      { "id": "memory", "component": "Text", "label": "MEM", "value": { "path": "/memory" } },
      { "id": "disk", "component": "Text", "label": "DISK", "value": { "path": "/disk" } },
      { "id": "frp", "component": "Text", "label": "FRP", "value": { "path": "/frp" } },
      { "id": "service", "component": "Text", "label": "SCREEN", "value": { "path": "/service" } },
      { "id": "refresh", "component": "Button", "label": "REFRESH", "action": { "event": { "name": "refresh_device_status", "context": {} } } },
      { "id": "restart", "component": "Button", "label": "RESTART", "action": { "event": { "name": "restart_walnut_screen_service", "context": {} } } },
      { "id": "reboot", "component": "Button", "label": "REBOOT DEVICE", "action": { "event": { "name": "reboot_device", "context": {} } } }
    ]
  },
  "updateDataModel": {
    "surfaceId": "device-status",
    "path": "/",
    "value": {
      "ip": "unknown",
      "memory": "unknown",
      "disk": "unknown",
      "frp": "unknown",
      "service": "unknown"
    }
  }
}
