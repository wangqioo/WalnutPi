{
  "version": "v0.9.1",
  "createSurface": {
    "surfaceId": "pomodoro",
    "catalogId": "walnutpi.lvgl-widget-catalog.v1"
  },
  "updateComponents": {
    "surfaceId": "pomodoro",
    "components": [
      {
        "id": "root",
        "component": "Container"
      },
      {
        "id": "bg",
        "component": "Container"
      },
      {
        "id": "title",
        "component": "Text",
        "text": "FOCUS"
      },
      {
        "id": "progressRing",
        "component": "Gauge"
      },
      {
        "id": "time",
        "component": "Text",
        "value": {
          "path": "/remaining"
        }
      },
      {
        "id": "status",
        "component": "Text",
        "value": {
          "path": "/status"
        }
      },
      {
        "id": "focusBar",
        "component": "Progress"
      },
      {
        "id": "start",
        "component": "Button",
        "label": "START",
        "action": {
          "event": {
            "name": "pomodoro_start",
            "context": {}
          }
        }
      },
      {
        "id": "pause",
        "component": "Button",
        "label": "PAUSE",
        "action": {
          "event": {
            "name": "pomodoro_pause",
            "context": {}
          }
        }
      },
      {
        "id": "reset",
        "component": "Button",
        "label": "RESET",
        "action": {
          "event": {
            "name": "pomodoro_reset",
            "context": {}
          }
        }
      },
      {
        "id": "hint",
        "component": "Text",
        "text": "Turn focus into a rhythm"
      }
    ]
  },
  "updateDataModel": {
    "surfaceId": "pomodoro",
    "path": "/",
    "value": {
      "remaining": "25:00",
      "status": "READY",
      "progress": 100,
      "mode": "idle"
    }
  }
}
